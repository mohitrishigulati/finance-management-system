# Copy to .env for local dev. Real Supabase/WhatsApp/Razorpay/Anthropic
# credentials are optional in v1 dev — see docs/DECISIONS.md. Every live
# call is gated behind these; missing = falls back to the mock/local path.

# Local Postgres (stands in for Supabase in dev; same schema/RLS shape).
DATABASE_URL_MIGRATOR=postgres://postgres:postgres@localhost:5432/finance_os_dev
DATABASE_URL_APP=postgres://app_user:app_user_dev_pw@localhost:5432/finance_os_dev

# Fixed dev-session identity until real Supabase Auth phone-OTP is wired up.
DEV_SESSION_USER_ID=

# Leave unset to use the mock/console-log fallback for each service.
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_CLOUD_API_PHONE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
ANTHROPIC_API_KEY=
